    $(BUILD_DIR)/src/libultra/os/getthreadid.o \
    $(BUILD_DIR)/src/libultra/os/getthreadpri.o \
    $(BUILD_DIR)/src/libultra/os/gettime.o \
    $(BUILD_DIR)/src/libultra/os/initialize.o \
    $(BUILD_DIR)/src/libultra/os/jammesg.o \
    $(BUILD_DIR)/src/libultra/os/kdebugserver.o \
    $(BUILD_DIR)/src/libultra/os/recvmesg.o \
    $(BUILD_DIR)/src/libultra/os/resetglobalintmask.o \
    $(BUILD_DIR)/src/libultra/os/sendmesg.o \
    $(BUILD_DIR)/src/libultra/os/seteventmesg.o \
    $(BUILD_DIR)/src/libultra/os/setglobalintmask.o \
    $(BUILD_DIR)/src/libultra/os/sethwintrroutine.o \
    $(BUILD_DIR)/src/libultra/os/setthreadpri.o \
    $(BUILD_DIR)/src/libultra/os/settime.o \
    $(BUILD_DIR)/src/libultra/os/settimer.o \
    $(BUILD_DIR)/src/libultra/os/startthread.o \
    $(BUILD_DIR)/src/libultra/os/stopthread.o \
    $(BUILD_DIR)/src/libultra/os/stoptimer.o \
    $(BUILD_DIR)/src/libultra/os/thread.o \
    $(BUILD_DIR)/src/libultra/os/timerintr.o \
    $(BUILD_DIR)/src/libultra/os/virtualtophysical.o \
    $(BUILD_DIR)/src/libultra/os/yieldthread.o \
    $(BUILD_DIR)/src/libultra/reg/_getcount.o \
    $(BUILD_DIR)/src/libultra/reg/_setcompare.o \
    $(BUILD_DIR)/src/code/kanread.o \
    $(BUILD_DIR)/src/libultra/gu/sins.o \
    $(BUILD_DIR)/src/libultra/gu/coss.o \
    $(BUILD_DIR)/src/linux/reimpl.o \
    $(BUILD_DIR)/src/s30/main.o \
    $(BUILD_DIR)/src/s30/buttons.o \
    $(N64LIB_OBJS)

# libultra's OS is the shared library's (n64/src/os.c): its os/, io/ and
# reg/ files aren't built, less the VI mode tables (data)
OBJECTS := $(filter-out $(BUILD_DIR)/src/libultra/os/%.o $(BUILD_DIR)/src/libultra/reg/%.o \
    $(filter-out $(BUILD_DIR)/src/libultra/io/vimode%.o $(BUILD_DIR)/src/libultra/io/vitbl.o,$(filter $(BUILD_DIR)/src/libultra/io/%.o,$(OBJECTS))),$(OBJECTS))

ALL_OBJECTS := $(OBJECTS) $(PLATFORM_OBJECTS) $(OVERLAY_OBJECTS)

all: $(TARGET)

extract:
	$(PYTHON) pc_tools/extract_rom.py --version $(VERSION)

assets:
	S30_SYSROOT=$(SYSROOT) OOT_VERSION=$(VERSION) $(PYTHON) pc_tools/make_assets.py

# Image base 0x40000000: code, data and the brk heap then sit above
# 0x10000000, so a real pointer never looks like an N64 segmented address
# (top byte 0x00-0x0F, see segmented_to_virtual / pc_resolve_addr)
$(TARGET): $(ALL_OBJECTS) | check-assets
	$(LINK) -no-pie -Wl,--image-base=0x40000000 $(ALL_OBJECTS) -o $@ $(ASSET_SYMBOLS) $(LIBS)

check-assets:
	@if [ ! -f "$(ASSET_DIR)/symbols.ld" ]; then \
		echo "Error: no asset ELFs. Run 'make -f Makefile.s30 assets' first."; \
		exit 1; \
	fi

# Platform layer: system headers (EGL, DRM, ALSA) need a real Linux target,
# so build it with the clang wrapper
$(BUILD_DIR)/src/s30/%.o: src/s30/%.c
	@mkdir -p $(dir $@)
	$(LINK) $(filter-out -fno-toplevel-reorder -mfloat-abi=hard -fno-short-enums -isystem $(SYSROOT)/usr/include,$(CFLAGS)) \
	    -I$(SYSROOT)/usr/include/libdrm -c $< -o $@

$(BUILD_DIR)/src/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Actor overlays are linked in, so their statics would outlive the overlay: each
# one's .data and .bss get their own sections (ovl_data_<name>, ovl_bss_<name>),
# which the game resets whenever the overlay loads again, as Overlay_Load would
$(BUILD_DIR)/src/overlays/actors/%.o: src/overlays/actors/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
	@$(OBJCOPY) --rename-section .data=ovl_data_$(OVL_NAME) --rename-section .bss=ovl_bss_$(OVL_NAME) $@

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

clean-assets:
	rm -rf $(ASSET_DIR)

.PHONY: all extract assets check-assets clean clean-assets

-include $(ALL_OBJECTS:.o=.d)
