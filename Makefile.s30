# Makefile.s30 - Ocarina of Time for the PocketGo S30 (Allwinner A33, ARMv7
# hard-float, Alpine musl, GLES2 on KMS/EGL, ALSA, evdev).
#
#   make -f Makefile.s30 extract    # ROM -> extracted/ + build/ inputs (host)
#   make -f Makefile.s30 assets     # asset segments for ARM (host)
#   make -f Makefile.s30 -j$(nproc) # zelda
#
# WORK is the pocketgo-s30 build tree (sysroot + armv7-clang wrapper).

WORK ?= ../../s30-build
# The shared N64 platform library (display, renderer, audio, input)
N64LIB ?= ../../n64
SYSROOT := $(abspath $(WORK)/sysroot)
PYTHON ?= .venv/bin/python3
VERSION ?= ntsc-1.0

# Compile with GCC (the game needs -fno-toplevel-reorder, which clang lacks)
# against the device's musl headers; link with the project's clang/lld wrapper
# against the Alpine sysroot (libc, libgcc/compiler-rt, GLES, ALSA).
CC := arm-none-eabi-gcc
OBJCOPY := arm-none-eabi-objcopy
# ovl_En_Slime/z_en_slime.o -> En_Slime
OVL_NAME = $(patsubst ovl_%,%,$(notdir $(patsubst %/,%,$(dir $@))))
LINK := $(WORK)/bin/armv7-clang

TARGET_FLAGS := -marm -march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 \
    -mfloat-abi=hard -fno-short-enums -isystem $(SYSROOT)/usr/include
VERSION_FLAGS := $(shell $(PYTHON) pc_tools/rom_meta.py --version $(VERSION) --cflags)

CFLAGS := $(TARGET_FLAGS) -O2 -Wall -std=gnu23 -DLINUX -D_LANGUAGE_C -D_GNU_SOURCE \
    $(VERSION_FLAGS) \
    -DF3DEX_GBI_2 -DF3DEX_GBI_PL -DGBI_DOWHILE -DGBI_DEBUG \
    -DMML_VERSION=MML_VERSION_OOT \
    -DBUILD_CREATOR='"zelda@srd022j"' -DBUILD_DATE='"03-02-21"' \
    -DBUILD_TIME='"00:16:31"' \
    -DREGION_JP=0 -DREGION_US=1 -DREGION_EU=2 -DREGION_NULL=255 \
    -Wno-incompatible-pointer-types -Wno-int-conversion \
    -g -fno-toplevel-reorder -fwrapv -fno-strict-aliasing -MMD -MP \
    -Iinclude -Iinclude/s30 -I$(N64LIB)/include/s30 -Isrc -I. -Iextracted/$(VERSION) -Ibuild/$(VERSION)

BUILD_DIR := build_s30
# libultra's OS from the library too (n64/src/os.c)
N64LIB_OS := 1
include $(N64LIB)/n64.mk
ASSET_DIR := build_assets/assets
TARGET := zelda
LIBS := $(N64LIB_LIBS)

OVERLAY_SRCS := $(filter-out %.inc.c %/z_map_mark_data.c %/z_lmap_mark_data.c,$(wildcard src/overlays/*/*/*.c))
OVERLAY_OBJECTS := $(patsubst src/%.c,$(BUILD_DIR)/src/%.o,$(OVERLAY_SRCS))

# Asset symbol addresses (segment-relative), one definition each
ASSET_SYMBOLS := -Wl,$(ASSET_DIR)/symbols.ld

# The files that differ between the N64 versions and the GameCube ones (spec/spec): the fault screen, the arena,
# the overlay loader; on N64 the boot and 64DD pieces the game calls (src/linux/n64.c: no drive)
ifneq ($(findstring -DPLATFORM_N64=1,$(VERSION_FLAGS)),)
PLATFORM_OBJECTS := $(BUILD_DIR)/src/code/fault_n64.o $(BUILD_DIR)/src/libc64/__osMalloc_n64.o \
    $(BUILD_DIR)/src/libu64/loadfragment2_n64.o $(BUILD_DIR)/src/linux/n64.o
else
PLATFORM_OBJECTS := $(BUILD_DIR)/src/code/fault_gc.o $(BUILD_DIR)/src/code/fault_gc_drawer.o \
    $(BUILD_DIR)/src/libc64/__osMalloc_gc.o $(BUILD_DIR)/src/libu64/load_gc.o \
    $(BUILD_DIR)/src/libu64/loadfragment2_gc.o $(BUILD_DIR)/src/libu64/logseverity_gc.o \
    $(BUILD_DIR)/src/libu64/relocation_gc.o
endif

